# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# Required: your Pollinations/OpenAI-compatible API key.
POLLINATIONS_API_KEY=your_api_key_here

# Optional: transcription model name.
POLLENSCRIBE_MODEL=whisper

# Optional: OpenAI-compatible base URL for Pollinations.
POLLINATIONS_BASE_URL=https://gen.pollinations.ai/v1

# Optional: silence trimming sensitivity.
# Higher values trim more aggressively; lower values keep quieter audio.
POLLENSCRIBE_SILENCE_THRESHOLD=500

# Optional: padding kept around detected speech, in milliseconds.
POLLENSCRIBE_TRIM_PADDING_MS=250
